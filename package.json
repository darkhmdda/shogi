{
  "name": "shogi",
  "private": true,
  "description": "Aplicación multiplataforma para aprender y jugar shōgi.",
  "workspaces": [
    "packages/engine",
    "packages/react",
    "packages/api",
    "apps/web",
    "apps/mobile"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web",
    "build": "npm run build --workspace web",
    "lint": "npm run lint --workspace web",
    "test": "npm test --workspace @shogi/engine --workspace @shogi/api",
    "typecheck": "npm run typecheck --workspace @shogi/engine --workspace @shogi/react --workspace @shogi/api --workspace mobile",
    "mobile": "npm start --workspace mobile",
    "build:function": "node scripts/build-edge-function.mjs",
    "test:functions": "vitest run supabase/functions"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "license": "MIT"
}
