# Por defecto la app usa el proyecto de Supabase de la web (src/config.ts).
# Para usar otro proyecto de Supabase:
# EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
# Para usar la API propia FastAPI (en un teléfono, la IP de tu ordenador):
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_API_URL=http://192.168.1.10:8000
